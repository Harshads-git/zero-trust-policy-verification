# Application Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Storage Configuration
# Options: 'sqlite' (local development) or 'dynamodb' (AWS Free Tier cloud)
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=policies.db

# AWS Cloud Settings (Free Tier)
# Note: In AWS Lambda or EC2 with IAM roles, leave AWS keys blank to use IAM Role metadata.
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=zero_trust_policies
DYNAMODB_AUDIT_TABLE=zero_trust_audit_logs

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
